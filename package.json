{
  "name": "optics-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "ui:dev": "vite apps/workbench-ui --host 127.0.0.1",
    "ui:dev:pseudo": "vite apps/workbench-ui --host 127.0.0.1 --mode pseudo",
    "ui:build": "tsc -b apps/workbench-ui && vite build apps/workbench-ui",
    "ui:build:pseudo": "tsc -b apps/workbench-ui && vite build apps/workbench-ui --mode pseudo",
    "ui:preview": "vite preview apps/workbench-ui --host 127.0.0.1",
    "i18n:extract": "i18next --config apps/workbench-ui/i18next-parser.config.cjs",
    "i18n:check": "i18next --config apps/workbench-ui/i18next-parser.config.cjs && node apps/workbench-ui/scripts/i18n-check.mjs",
    "i18n:coverage": "node apps/workbench-ui/scripts/i18n-coverage.mjs",
    "i18n:test": "node apps/workbench-ui/scripts/i18n-unit-tests.mjs",
    "svg:export:test": "node apps/workbench-ui/scripts/svg-export-readback.mjs",
    "chart:test": "node apps/workbench-ui/scripts/chart-theme-tests.mjs",
    "ui:e2e": "playwright test --config apps/workbench-ui/playwright.config.ts",
    "ci": "npm.cmd run ui:build && npm.cmd run i18n:check && npm.cmd run i18n:coverage && npm.cmd run i18n:test && npm.cmd run svg:export:test && npm.cmd run chart:test && npm.cmd run ui:e2e"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.78.0",
    "@carbon/react": "^1.96.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^5.1.1",
    "i18next": "^26.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "i18next-parser": "^9.0.2"
  }
}
